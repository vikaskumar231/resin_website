datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  ARTISAN_ADMIN
  WORKSHOP_MAKER
  SUPER_ADMIN
}

enum ProductType {
  READY_TO_SHIP
  CUSTOMIZABLE
}

enum ProductBadge {
  BESTSELLER
  MASTERPIECE
  FESTIVE_SPECIAL
  LIMITED_EDITION
  NEW_ARRIVAL
}

enum OrderStatus {
  PAYMENT_PENDING
  ORDER_CONFIRMED
  PROOF_PENDING
  PROOF_APPROVED
  IN_PRODUCTION
  FINISHING_QC
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id              String    @id @default(uuid())
  phone           String?   @unique
  email           String?   @unique
  name            String?
  passwordHash    String?
  avatarUrl       String?
  role            Role      @default(CUSTOMER)
  isPhoneVerified Boolean   @default(false)
  isEmailVerified Boolean   @default(false)
  addresses       Address[]
  orders          Order[]
  reviews         Review[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([phone])
  @@index([email])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       String   @default("Home")
  fullName  String
  phone     String
  street    String
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([pincode])
}

model Product {
  id                String        @id @default(uuid())
  slug              String        @unique
  title             String
  subtitle          String?
  description       String?
  category          String
  productType       ProductType   @default(CUSTOMIZABLE)
  badge             ProductBadge?
  basePrice         Float
  compareAtPrice    Float?
  inventoryCount    Int           @default(50)
  lowStockThreshold Int           @default(5)
  images            String[]
  videoUrl          String?
  isActive          Boolean       @default(true)
  customizerConfig  Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  orderItems        OrderItem[]
  reviews           Review[]

  @@index([category])
  @@index([productType])
  @@index([badge])
}

model Order {
  id                   String        @id @default(uuid())
  orderNumber          String        @unique
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id])
  customerPhone        String
  customerEmail        String?
  status               OrderStatus   @default(ORDER_CONFIRMED)
  paymentStatus        PaymentStatus @default(PENDING)
  razorpayOrderId      String?       @unique
  razorpayPaymentId    String?       @unique
  subtotal             Float
  discount             Float         @default(0)
  couponCode           String?
  shippingFee          Float         @default(0)
  taxAmount            Float         @default(0)
  taxDetails           Json?
  grandTotal           Float
  shippingAddress      Json
  billingAddress       Json?
  b2bDetails           Json?
  isGift               Boolean       @default(false)
  giftMessage          String?
  invoiceNumber        String?       @unique
  invoicePdfUrl        String?
  isCodDeposit         Boolean       @default(false)
  codDepositAmount     Float?
  shiprocketShipmentId String?
  shiprocketAwb        String?
  trackingUrl          String?
  items                OrderItem[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([userId])
  @@index([customerPhone])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id                   String  @id @default(uuid())
  orderId              String
  order                Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId            String
  product              Product @relation(fields: [productId], references: [id])
  quantity             Int     @default(1)
  unitPrice            Float
  hsnCode              String  @default("3926")
  customizationDetails Json?
  previewImageUrl      String?
  proofImageUrl        String?
  proofStatus          String  @default("NOT_REQUIRED")
  proofRevisionCount   Int     @default(0)

  @@index([orderId])
  @@index([productId])
}

model Coupon {
  id                String    @id @default(uuid())
  code              String    @unique
  discountType      String
  discountValue     Float
  maxDiscountAmount Float?
  minOrderValue     Float     @default(0)
  usageLimit        Int?
  usageCount        Int       @default(0)
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())

  @@index([code])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  authorName String
  rating     Int
  headline   String?
  comment    String
  photoUrls  String[]
  isVerified Boolean  @default(false)
  status     String   @default("APPROVED")
  createdAt  DateTime @default(now())

  @@index([productId])
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([token])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([token])
}
