NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_mock_art_aalay"

# WhatsApp Cloud API Mock Configuration
WHATSAPP_PHONE_NUMBER_ID="mock_phone_number_id"
WHATSAPP_ACCESS_TOKEN="mock_whatsapp_access_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="art_aalay_webhook_secret_2026"

# Shiprocket Courier Mock Configuration
SHIPROCKET_API_EMAIL="artisan@artaalay.com"
