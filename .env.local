# Artआलय Local Development Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (Local PostgreSQL on localhost:5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/art_aalay?schema=public"

# Dual-Mode Mock Architecture (Active for instant local testing)
MOCK_MODE="true"

# Razorpay Mock Configuration
RAZORPAY_KEY_ID="rzp_test_mock_art_aalay"
