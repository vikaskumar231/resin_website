# Artआलय (Resin E-Commerce) Environment Variables
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/art_aalay?schema=public"

# Development & Mock Mode Invariant (Zero third-party blockage)
MOCK_MODE="true"

# Razorpay (UPI & NetBanking Payment Gateway)
RAZORPAY_KEY_ID="rzp_test_mock_art_aalay"
RAZORPAY_KEY_SECRET="mock_secret_key_12345"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_mock_art_aalay"

# WhatsApp Cloud API (Artisan Proof Approval & Customer Notifications)
WHATSAPP_PHONE_NUMBER_ID="mock_phone_number_id"
WHATSAPP_ACCESS_TOKEN="mock_whatsapp_access_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="art_aalay_webhook_secret_2026"

# Shiprocket Courier & Logistics
SHIPROCKET_API_EMAIL="artisan@artaalay.com"
SHIPROCKET_API_PASSWORD="mock_shiprocket_password"

# NextAuth / JWT Authentication Secret
NEXTAUTH_SECRET="art_aalay_super_secret_jwt_key_resin_delight_32_chars_min"
NEXTAUTH_URL="http://localhost:3000"

