# ==============================================================================
# Artआलय (Resin E-Commerce) — Production Environment Variables
# ==============================================================================
# Set NODE_ENV="production" on your live deployment server
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# --- Database Configuration (PostgreSQL / Supabase / Neon / Railway) ---
DATABASE_URL="postgresql://user:password@host:5432/art_aalay?schema=public"

# --- Dual-Mode Architecture ---
# Set MOCK_MODE="false" in production to activate live Razorpay, WhatsApp, & Shiprocket
MOCK_MODE="false"

# --- Razorpay (UPI, NetBanking & Cards Payment Gateway) ---
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_live_razorpay_secret_key"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"

# --- WhatsApp Cloud API (Artisan Proof Approval & Customer Notifications) ---
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_permanent_system_user_access_token"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_strong_webhook_verify_token"

# --- Shiprocket Courier & Logistics ---
SHIPROCKET_API_EMAIL="artisan@your-domain.com"
SHIPROCKET_API_PASSWORD="your_secure_shiprocket_password"

# --- Cryptographic Session Security & Secrets (MANDATORY IN PRODUCTION) ---
# Generate high-entropy keys using: openssl rand -base64 32
SESSION_SECRET="generate_32_char_minimum_high_entropy_random_secret_here"
NEXTAUTH_SECRET="generate_32_char_minimum_high_entropy_random_secret_here"
ADMIN_API_KEY="generate_32_byte_hex_token_for_machine_to_machine_admin_api"

# --- Artisan Master Administrator Credentials ---
# In production, DO NOT use default names or weak passwords. Min 12 chars required.
ADMIN_USERNAME="artisan_admin"
ADMIN_PASSWORD="ChooseAStrongProductionPassword_Min12Chars!"
NEXTAUTH_URL="https://your-domain.com"

