datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS (1:1 Match with database/schema.sql)
// ============================================================================

enum Role {
  CUSTOMER
  ARTISAN_ADMIN
  WORKSHOP_MAKER
  SUPER_ADMIN
}

enum ProductType {
  READY_TO_SHIP
  CUSTOMIZABLE
}

enum ProductBadge {
  BESTSELLER
  MASTERPIECE
  FESTIVE_SPECIAL
  LIMITED_EDITION
  NEW_ARRIVAL
}

enum OrderStatus {
  PAYMENT_PENDING
  ORDER_CONFIRMED
  PROOF_PENDING
  PROOF_APPROVED
  IN_PRODUCTION
  FINISHING_QC
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY_UPI
  RAZORPAY_CARD
  RAZORPAY_NETBANKING
  COD_PARTIAL_DEPOSIT
}

enum ProofStatus {
  NOT_REQUIRED
  PENDING_ARTISAN_UPLOAD
  PENDING_CUSTOMER_APPROVAL
  APPROVED
  REVISION_REQUESTED
  SKIPPED_BY_ARTISAN
}

enum DiscountType {
  PERCENTAGE
  FLAT_AMOUNT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BreakageClaimStatus {
  PENDING_REVIEW
  APPROVED_REPLACEMENT
  REJECTED
}

enum BatchStatus {
  PLANNED
  MIXING
  POURED
  CURING_48H
  COMPLETED
}

// ============================================================================
// DOMAIN 1: IDENTITY, RBAC & ADDRESS BOOK
// ============================================================================

model User {
  id                  String               @id @default(uuid())
  phone               String?              @unique
  email               String?              @unique
  name                String?
  passwordHash        String?
  avatarUrl           String?
  role                Role                 @default(CUSTOMER)
  isPhoneVerified     Boolean              @default(false)
  isEmailVerified     Boolean              @default(false)
  isActive            Boolean              @default(true)
  addresses           Address[]
  orders              Order[]
  orderItems          OrderItem[]
  reviews             Review[]
  savedDesigns        SavedDesign[]
  passwordResetTokens PasswordResetToken[]
  assignedBatches     ProductionBatch[]
  orderStatusChanges  OrderStatusHistory[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([phone])
  @@index([email])
  @@index([role])
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       String   @default("Home") // 'Home', 'Work', 'Recipient'
  fullName  String
  phone     String
  street    String
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([pincode])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String // Phone or Email
  token      String
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, token])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
}

// ============================================================================
// DOMAIN 2: CATALOG MERCHANDISING & PRODUCTS
// ============================================================================

model Category {
  id           String    @id @default(uuid())
  slug         String    @unique
  name         String
  description  String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
}

model Product {
  id                String         @id @default(uuid())
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  slug              String         @unique
  title             String
  subtitle          String?
  description       String?
  productType       ProductType    @default(CUSTOMIZABLE)
  badge             ProductBadge?
  basePrice         Decimal        @db.Decimal(10, 2)
  compareAtPrice    Decimal?       @db.Decimal(10, 2)
  inventoryCount    Int            @default(50)
  lowStockThreshold Int            @default(5)
  curingLeadDays    Int            @default(3)
  dimensions        String?
  isActive          Boolean        @default(true)
  customizerConfig  Json?
  images            ProductImage[]
  orderItems        OrderItem[]
  reviews           Review[]
  savedDesigns      SavedDesign[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([badge])
  @@index([productType])
  @@index([isActive])
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([productId])
}

model SavedDesign {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shareToken      String   @unique
  designState     Json
  previewImageUrl String?
  createdAt       DateTime @default(now())

  @@index([shareToken])
}

// ============================================================================
// DOMAIN 3: CHECKOUT, ORDERS & INDIAN TAX COMPLIANCE
// ============================================================================

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Decimal      @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  minOrderValue     Decimal      @default(0.00) @db.Decimal(10, 2)
  usageLimit        Int?
  usageCount        Int          @default(0)
  isActive          Boolean      @default(true)
  expiresAt         DateTime?
  orders            Order[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([code])
}

model Order {
  id                       String               @id @default(uuid())
  orderNumber              String               @unique // e.g. 'ART-2026-1001'
  userId                   String?
  user                     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerPhone            String
  customerEmail            String?
  status                   OrderStatus          @default(ORDER_CONFIRMED)
  paymentStatus            PaymentStatus        @default(PENDING)
  paymentMethod            PaymentMethod        @default(RAZORPAY_UPI)
  subtotal                 Decimal              @db.Decimal(10, 2)
  discount                 Decimal              @default(0.00) @db.Decimal(10, 2)
  couponId                 String?
  coupon                   Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingFee              Decimal              @default(0.00) @db.Decimal(10, 2)
  grandTotal               Decimal              @db.Decimal(10, 2)
  isCodDeposit             Boolean              @default(false)
  codDepositAmount         Decimal?             @default(0.00) @db.Decimal(10, 2)
  balanceCodAmount         Decimal?             @default(0.00) @db.Decimal(10, 2)
  shippingAddress          Json
  billingAddress           Json?
  isBillingSameAsShipping  Boolean              @default(true)
  isGift                   Boolean              @default(false)
  giftMessage              String?
  giftWrapFee              Decimal              @default(0.00) @db.Decimal(10, 2)
  cancellationReason       String?
  cancelledAt              DateTime?
  items                    OrderItem[]
  payments                 Payment[]
  shippingManifest         ShippingManifest?
  statusHistory            OrderStatusHistory[]
  transitBreakageClaims    TransitBreakageClaim[]
  refunds                  Refund[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([orderNumber])
  @@index([userId])
  @@index([customerPhone])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                   String           @id @default(uuid())
  orderId              String
  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId            String
  product              Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity             Int              @default(1)
  unitPrice            Decimal          @db.Decimal(10, 2)
  customizationDetails Json?
  previewImageUrl      String?
  proofStatus          ProofStatus      @default(NOT_REQUIRED)
  proofImageUrl        String?
  proofRevisionCount   Int              @default(0)
  proofRequest         ProofRequest?
  batchOrderItem       BatchOrderItem?
  createdAt            DateTime         @default(now())

  @@index([orderId])
  @@index([userId])
  @@index([productId])
  @@index([proofStatus])
}

model OrderStatusHistory {
  id                 String       @id @default(uuid())
  orderId            String
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus     OrderStatus?
  newStatus          OrderStatus
  changedByUserId    String?
  changedBy          User?        @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)
  note               String?
  createdAt          DateTime     @default(now())

  @@index([orderId])
}

model Payment {
  id                 String        @id @default(uuid())
  orderId            String
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId    String
  razorpayPaymentId  String?       @unique
  razorpaySignature  String?
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("INR")
  status             PaymentStatus @default(PENDING)
  paymentMethod      String?
  gatewayFee         Decimal?      @default(0.00) @db.Decimal(10, 2)
  gatewayTax         Decimal?      @default(0.00) @db.Decimal(10, 2)
  rawWebhookPayload  Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([orderId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
}

// ============================================================================
// DOMAIN 4: PROOF APPROVAL LOOP
// ============================================================================

model ProofRequest {
  id                  String          @id @default(uuid())
  orderItemId         String          @unique
  orderItem           OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  status              ProofStatus     @default(PENDING_ARTISAN_UPLOAD)
  proofImageUrl       String?
  artisanNotes        String?
  isSkippedByArtisan  Boolean         @default(false)
  skipReason          String?
  whatsappMessageSid  String?
  approvedAt          DateTime?
  revisions           ProofRevision[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([orderItemId])
  @@index([status])
}

model ProofRevision {
  id                     String       @id @default(uuid())
  proofRequestId         String
  proofRequest           ProofRequest @relation(fields: [proofRequestId], references: [id], onDelete: Cascade)
  revisionNumber         Int          @default(1)
  customerFeedback       String
  adjustedMockupImageUrl String?
  createdAt              DateTime     @default(now())

  @@index([proofRequestId])
}

// ============================================================================
// DOMAIN 5: WORKSHOP KANBAN, BATCH POURS & LOGISTICS
// ============================================================================

model ProductionBatch {
  id                 String           @id @default(uuid())
  batchCode          String           @unique
  colorway           String
  totalResinVolumeMl Int
  hardenerVolumeMl   Int
  assignedArtisanId  String?
  assignedArtisan    User?            @relation(fields: [assignedArtisanId], references: [id], onDelete: SetNull)
  status             BatchStatus      @default(PLANNED)
  pourStartedAt      DateTime?
  curingCompletedAt  DateTime?
  batchItems         BatchOrderItem[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([batchCode])
}

model BatchOrderItem {
  id          String          @id @default(uuid())
  batchId     String
  batch       ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderItemId String          @unique
  orderItem   OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  assignedAt  DateTime        @default(now())

  @@index([batchId])
}

model ShippingManifest {
  id                   String         @id @default(uuid())
  orderId              String         @unique
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shiprocketShipmentId String?
  shiprocketOrderId    String?
  awbNumber            String?        @unique
  courierName          String?
  shippingLabelUrl     String?
  trackingUrl          String?
  pickupScheduledDate  DateTime?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  transitEvents        TransitEvent[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([orderId])
  @@index([awbNumber])
}

model TransitEvent {
  id                  String           @id @default(uuid())
  shippingManifestId  String
  shippingManifest    ShippingManifest @relation(fields: [shippingManifestId], references: [id], onDelete: Cascade)
  location            String?
  statusCode          String
  activityDescription String
  eventTimestamp      DateTime
  createdAt           DateTime         @default(now())

  @@index([shippingManifestId])
}

model TransitBreakageClaim {
  id                 String              @id @default(uuid())
  orderId            String
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customerPhone      String
  photoProofUrls     String[]
  description        String
  status             BreakageClaimStatus @default(PENDING_REVIEW)
  replacementOrderId String?
  artisanNotes       String?
  resolvedAt         DateTime?
  createdAt          DateTime            @default(now())

  @@index([orderId])
}

// ============================================================================
// DOMAIN 6: SOCIAL PROOF, INVENTORY & REFUNDS
// ============================================================================

model Review {
  id              String       @id @default(uuid())
  productId       String
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName      String
  rating          Int
  headline        String?
  comment         String
  photoUrls       String[]
  isVerifiedBuyer Boolean      @default(false)
  status          ReviewStatus @default(APPROVED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([productId])
  @@index([status])
}

model Refund {
  id               String        @id @default(uuid())
  orderId          String
  order            Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  razorpayRefundId String?       @unique
  amount           Decimal       @db.Decimal(10, 2)
  reason           String
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())

  @@index([orderId])
}
